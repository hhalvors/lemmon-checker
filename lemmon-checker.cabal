cabal-version:       >=1.10
name:                lemmon-checker
version:             0.1.0.0
build-type:          Simple

library
  hs-source-dirs:      src
  -- -Wall on the library is what makes the exhaustive case in
  -- LemmonChecker.checkJustification enforceable: a rule added to
  -- Justification but not checked shows up as an incomplete-pattern warning.
  ghc-options:         -Wall
  exposed-modules:
      ProofTypes
      LemmonChecker
      PrettyPrint
      FormulaParser
      PipeParse
      ModelSemantics
      Normalize
      TruthTable
      PropDNF
      OcrLatexToPipe
      LatexPretty
      ProofToLaTeX
      TruthTable.LaTeX
      TruthTable.Html
      TruthTable.Text
      TruthTable.Style
  build-depends:
      base >=4.7 && <5
    , blaze-html
    , aeson
    , text
    , containers
    , parsec
    , split
  default-language:    Haskell2010

executable lemmon-check
  main-is:             Main.hs
  hs-source-dirs:      app
  build-depends:       base, lemmon-checker, aeson, text, bytestring
  default-language:    Haskell2010

executable json-to-pipe
  main-is:             JsonToPipe.hs
  hs-source-dirs:      app
  build-depends:       base, aeson, bytestring, text, containers, lemmon-checker
  default-language:    Haskell2010

executable pipe-to-json
  hs-source-dirs:      app
  main-is:             PipeToJson.hs
  ghc-options:         -Wall
  -- Parsing comes from the library (PipeParse), so this exe no longer needs
  -- split/parsec/text/containers of its own.
  build-depends:
      base >=4.7 && <5,
      aeson,
      bytestring,
      lemmon-checker
  default-language:    Haskell2010

executable pipe-check
  hs-source-dirs:      app
  main-is:             PipeCheck.hs
  -- Parsing comes from the library (PipeParse); containers is still needed
  -- for Data.Set in the JSON report.
  build-depends:
      base >=4.7 && <5
    , aeson
    , bytestring
    , containers
    , lemmon-checker
  default-language:    Haskell2010
  ghc-options:         -Wall

executable web
  main-is:             Web.hs
  hs-source-dirs:      app
  build-depends:
      base
    , lemmon-checker
    , time
    , scotty
    , wai
    , wai-middleware-static
    , wai-extra
    , aeson
    , text
    , bytestring
    , containers
    , http-types
    , http-conduit
    , http-client
    , http-client-tls
    , unordered-containers
    , vector
    , blaze-html
    , blaze-markup
  default-language:    Haskell2010

executable eval-score
  main-is:             EvalScore.hs
  hs-source-dirs:      app
  ghc-options:         -Wall
  build-depends:
      base >=4.7 && <5
    , containers
    , directory
    , filepath
    , lemmon-checker
  default-language:    Haskell2010

executable model-test
  main-is:          ModelTest.hs
  hs-source-dirs:   app
  build-depends:
      base
    , lemmon-checker
    , containers
    , text
  default-language: Haskell2010  

test-suite lemmon-checker-test
  type:                exitcode-stdio-1.0
  hs-source-dirs:      test
  main-is:             Tests.hs
  build-depends:       base, lemmon-checker
  default-language:    Haskell2010
